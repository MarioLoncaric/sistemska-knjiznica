<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox stylesheets="@style.css" prefHeight="600.0" prefWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.sistemska_knjiznica.ChangeLogController">
   <children>
      <Label text="Povijest promjena">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="timeColumn" prefWidth="180.0" text="Vrijeme" />
          <TableColumn fx:id="actionColumn" prefWidth="560.0" text="Akcija" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>
